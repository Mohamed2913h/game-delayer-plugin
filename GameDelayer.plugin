// ==UserScript==
// @name= Game Request Delayer
// @desc= Delay game requests by 200ms | Updated: 2024-12-20
// @author= Mohamed2913h
// @version= 1.1.0
// @icon= https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/source/avatar.jpg
// @homepage= https://github.com/Mohamed2913h/game-delayer-plugin
// ==/UserScript==

[Script]
# Main delay script
game-delay-engine = type=http-request,pattern=^https?://,script-path=https://raw.githubusercontent.com/Mohamed2913h/game-delayer-plugin/main/delay-processor.js,requires-body=true,timeout=30

# Panel display script  
game-panel = script-path=https://raw.githubusercontent.com/Mohamed2913h/game-delayer-plugin/main/control-panel.js,type=panel

[MITM]
hostname = *

[Panel]
Game Delayer = script-name=game-panel,update-interval=5
