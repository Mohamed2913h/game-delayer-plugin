#!name= Game Delayer
#!desc= Delay game requests by 200ms
#!icon= gamecontroller
#!author= Mohamed2913h
#!homepage= https://github.com/Mohamed2913h/game-delayer-plugin

[Rewrite]
# Rule 1: Delay PUBG Mobile
^https?:\/\/.*\.pubg\.com.* - delay=200

# Rule 2: Delay Free Fire  
^https?:\/\/.*\.garena\.com.* - delay=200

# Rule 3: Delay COD Mobile
^https?:\/\/.*\.activision\.com.* - delay=200

# Rule 4: Delay Mobile Legends
^https?:\/\/.*\.mobilelegends\.com.* - delay=200

# Rule 5: Delay other games (catch-all)
^https?:\/\/.*(game|gaming|play)\.com.* - delay=200

[MITM]
hostname = %APPEND% *.pubg.com, *.garena.com, *.activision.com, *.mobilelegends.com, *.supercell.com

[Script]
# Statistics panel
game-stats = type=panel,script-path=https://raw.githubusercontent.com/Mohamed2913h/game-delayer-plugin/main/game-stats.js
