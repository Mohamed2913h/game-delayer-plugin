#!name= Game Delayer
#!desc= Delay game requests by 200ms | Updated: 2024-12-20
#!openUrl= https://github.com/Mohamed2913h/game-delayer-plugin
#!author= Mohamed2913h
#!homepage= https://github.com/Mohamed2913h/game-delayer-plugin
#!icon= https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/source/avatar.jpg
#!delay= 200
#!mitm= 15
#!total= 20

[Rewrite]
# PUBG Mobile
^https?:\/\/.*\.pubg\.com\/.* - delay-request=200

# Free Fire
^https?:\/\/.*\.garena\.com\/.* - delay-request=200

# Call of Duty Mobile
^https?:\/\/.*\.activision\.com\/.* - delay-request=200

# Mobile Legends
^https?:\/\/.*\.mobilelegends\.com\/.* - delay-request=200

# Clash of Clans/Royale
^https?:\/\/.*\.supercell\.com\/.* - delay-request=200

# Genshin Impact
^https?:\/\/.*\.(mihoyo|hoyoverse)\.com\/.* - delay-request=200

# Roblox
^https?:\/\/.*\.roblox\.com\/.* - delay-request=200

# Fortnite
^https?:\/\/.*\.epicgames\.com\/.* - delay-request=200

# Steam Games
^https?:\/\/.*\.steam(powered)?\.com\/.* - delay-request=200

# General Game APIs
^https?:\/\/.*\/api\/.*game.* - delay-request=200

[MITM]
hostname = *.pubg.com, *.garena.com, *.activision.com, *.mobilelegends.com, *.supercell.com, *.mihoyo.com, *.hoyoverse.com, *.roblox.com, *.epicgames.com, *.steam.com, *.steampowered.com, %APPEND%
